---
import { site } from '../data/site';

const parts = site.name.trim().split(/\s+/);
const firstName = parts.shift() ?? site.name;
const lastName = parts.join(' ');
const base = import.meta.env.BASE_URL;

const tickerItems = [
  'ACCESS GRANTED',
  'PERSONNEL DOSSIER VERIFIED',
  'CLEARANCE LEVEL 04',
  'CONNECTION STABLE',
  'AWAITING INPUT',
];
---

<section class="hero" id="top">
  <div class="shell hero__grid">
    <div class="hero__copy" data-reveal>
      <p class="eyebrow"><span class="eyebrow__bar"></span> DATASHARD // PERSONNEL DOSSIER</p>

      <h1 class="hero__title">
        <span class="glitch" data-text={firstName}>{firstName}</span>
        {lastName && <span class="hero__title-second glitch" data-text={lastName}>{lastName}</span>}
      </h1>

      <p class="hero__role">{site.role}</p>
      <p class="hero__bio">{site.bio}</p>

      <div class="hero__actions">
        <a class="btn btn--solid" href="#cv">
          OPEN CV
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
        <a class="btn btn--ghost" href="#projects">VIEW PROJECTS</a>
      </div>

      <div class="hero__meta">
        <div><strong>Location</strong>{site.location}</div>
        <div><strong>Clearance</strong>{site.clearance}</div>
        <div><strong>Status</strong><span class="available">{site.availability}</span></div>
      </div>
    </div>

    <div class="hero__card" data-reveal>
      <div class="panel id-card">
        <div class="id-card__head">
          <span>DATASHARD_0x7F // 04</span>
          <span class="id-card__badge">VERIFIED</span>
        </div>

        <div class="id-card__body">
          <div class="id-card__portrait">
            <img src={`${base}avatar.svg`} alt="" width="128" height="152" />
          </div>
          <dl class="id-card__fields">
            <dt>ID</dt>
            <dd class="accent">{site.initials}-77//042</dd>
            <dt>Name</dt>
            <dd>{site.name}</dd>
            <dt>Class</dt>
            <dd>Developer</dd>
            <dt>Origin</dt>
            <dd>{site.location}</dd>
            <dt>Access</dt>
            <dd class="accent">GRANTED</dd>
          </dl>
        </div>

        <div class="id-card__footer">
          <span class="barcode" aria-hidden="true"></span>
          <span>SYS.2077</span>
        </div>
      </div>
    </div>
  </div>

  <div class="ticker" aria-hidden="true">
    <div class="ticker__track">
      {[0, 1].map(() => (
        <div class="ticker__chunk">
          {tickerItems.map((item) => <span>{item}</span>)}
        </div>
      ))}
    </div>
  </div>
</section>
