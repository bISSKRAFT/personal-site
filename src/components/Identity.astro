---
import Shard from './Shard.astro';
import { site } from '../data/site';

interface InfoRow {
  label: string;
  value: string;
  encrypted?: boolean;
}

const info: InfoRow[] = [
  { label: 'Location', value: site.location },
  { label: 'Email', value: site.email },
  { label: 'Comms', value: site.commsMask, encrypted: true },
  { label: 'Languages', value: site.languages },
  { label: 'Availability', value: site.availability },
  { label: 'Clearance', value: site.clearance },
];
---

<Shard id="identity" index="01" code="0x01" label="PERSONAL INFORMATION" title="Identity">
  <div class="identity__grid">
    <div>
      <p class="identity__lead">{site.tagline}</p>
      <p class="identity__text">{site.bio}</p>
      <blockquote class="identity__quote">
        &gt; “{site.motto}”
        <span>LOG ENTRY // 042.7</span>
      </blockquote>

      <div class="chips" aria-label="Interests">
        {site.interests.map((interest) => <span class="chip">{interest}</span>)}
      </div>
    </div>

    <div>
      <dl class="info-list">
        {info.map((row) => (
          <div class="info-list__row">
            <dt>{row.label}</dt>
            <dd>
              {row.encrypted ? (
                <div class="cipher-block">
                  <span class="cipher" role="img" aria-label="Phone number withheld — channel encrypted">
                    <span class="cipher__mask">{row.value}</span>
                    <span class="cipher__hex">{site.commsKey}</span>
                  </span>
                  <button class="cipher__btn" type="button" data-cipher-button>DECRYPT</button>
                  <span class="cipher__result" data-cipher-result aria-live="polite">CHANNEL SEALED</span>
                </div>
              ) : row.value}
            </dd>
          </div>
        ))}
      </dl>

      <div class="chips" aria-label="Social links">
        {site.socials.map((social) => (
          <a class="chip" href={social.url} target="_blank" rel="noopener noreferrer">
            {social.label}: {social.handle}
          </a>
        ))}
      </div>
    </div>
  </div>
</Shard>
